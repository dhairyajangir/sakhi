rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isVolunteer() {
      return isAuthenticated() && getUserRole() == 'volunteer';
    }

    // ── Users Collection ──
    match /users/{userId} {
      // Admins can read/write all users; authenticated users can read profiles
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      // ── Emergency Contacts Subcollection ──
      match /emergencyContacts/{contactId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // ── Sessions Collection ──
    match /sessions/{sessionId} {
      // Admins have full access; authenticated users can read
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
                    || (
                      isAuthenticated()
                      && (
                        resource.data.createdBy == request.auth.uid
                        || (
                          resource.data.status == 'searching'
                          && request.resource.data.status == 'active'
                          && request.resource.data.volunteerId == request.auth.uid
                        )
                        || resource.data.volunteerId == request.auth.uid
                      )
                    );
      allow delete: if isAdmin();

      // ── Location Updates Subcollection ──
      match /locationUpdates/{updateId} {
        allow read: if isAdmin()
                    || (
                      isAuthenticated()
                      && (
                        get(/databases/$(database)/documents/sessions/$(sessionId)).data.createdBy == request.auth.uid
                        || get(/databases/$(database)/documents/sessions/$(sessionId)).data.volunteerId == request.auth.uid
                      )
                    );
        allow create: if isAuthenticated()
                      && request.resource.data.uid == request.auth.uid
                      && get(/databases/$(database)/documents/sessions/$(sessionId)).data.createdBy == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Broadcasts Collection ──
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Location Shares Collection ──
    match /locationShares/{shareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (
                      isAuthenticated()
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid
                    );
      allow delete: if isAdmin();
    }

    // ── Helper: Check if a volunteer is KYC-verified ──
    function isVerifiedVolunteer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified';
    }

    // ── Walking Sessions Collection ──
    match /walking_sessions/{sessionId} {
      // Both the user and the assigned volunteer can read the session.
      // Admins have full read access.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.volunteerId ||
        isAdmin()
      );

      // Any authenticated user can create a walking session.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // State machine enforcement:
      allow update: if isAuthenticated() && (
        // 1. Verified volunteers can accept a searching session
        (resource.data.status == 'searching'
         && request.resource.data.status == 'volunteerAccepted'
         && isVerifiedVolunteer())
        ||
        // 2. The session user can confirm a volunteer
        (resource.data.status == 'volunteerAccepted'
         && request.resource.data.status == 'volunteerConfirmed'
         && request.auth.uid == resource.data.userId)
        ||
        // 3. Either party can update during active phases
        (request.auth.uid == resource.data.userId
         || request.auth.uid == resource.data.volunteerId)
        ||
        // 4. Admins always allowed
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Live Locations Collection ──
    match /liveLocations/{userId} {
      // Users can always write their own location
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Users can read their own; admins can read all
      allow read: if isAuthenticated()
                  && (request.auth.uid == userId || isAdmin());
    }
  }
}
